{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/launch.sh\" maintain --startup",
            "commandWindows": "\"%PLUGIN_ROOT%\\scripts\\launch.cmd\" maintain --startup",
            "statusMessage": "Maintaining Claude skill plugins",
            "timeout": 300,
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
