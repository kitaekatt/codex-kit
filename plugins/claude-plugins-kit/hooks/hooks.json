{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?CLAUDE_PLUGIN_ROOT or PLUGIN_ROOT must be set}}\"; exec \"$root/scripts/launch.sh\" maintain --startup",
            "commandWindows": "cmd.exe /d /c %CLAUDE_PLUGIN_ROOT%\\scripts\\launch.cmd maintain --startup",
            "statusMessage": "Maintaining Claude skill plugins",
            "timeout": 300,
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
